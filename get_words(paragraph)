import re
def get_words(paragraph):

    paragraph = paragraph.lower()

    paragraph = re.sub(r"[\!\,\.]", "", paragraph, re.M)

    paragraph = paragraph.split(" ")

    i = 0

    my_dict = {}

    while i < len(paragraph):

        my_dict[f"{paragraph[i]}"] = paragraph.count(f"{paragraph[i]}")

        i+=1
    
    my_dict_sorted = dict(sorted(my_dict.items(), key=lambda item : item[1], reverse=True))
    

    return [list(my_dict_sorted)[0], list(my_dict_sorted)[1], list(my_dict_sorted)[2]]



print(get_words("I like coding. I like testing. I love debugging!"))
