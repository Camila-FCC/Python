def fizz_buzz(n):

    i = 1

    fizz_buzz = []

    while i < (n+1):

        condition = "FizzBuzz" if (i % 3 == 0 and i % 5 == 0) else "Fizz" if i % 3 == 0 else "Buzz" if i % 5 == 0 else i

        fizz_buzz.append(condition)

        i+=1

    return fizz_buzz


print(fizz_buzz(50))
