def one_hundred(chars):

    #chars = chars.split()

    chars_length = len(chars)

    i = 0

    result = []

    while True:
    
        result.append(chars[i])

        if i > (chars_length - 2):
            i = -1

        if len(result) > 99:
            break

        i+=1

    return "".join(result)


print(one_hundred("One hundred "))
