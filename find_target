def find_target(arr, target):

    i = 0

    while i < (len(arr)-1):

        if arr[i] + arr[i+1] == target:

            return [i, i+1]
        
        i+=1

    return "Target not found"


print(find_target([2, 7, 11, 15], 9))
# [0, 1]

print(find_target([3, 2, 4, 5], 6))
# [1, 2]

print(find_target([1, 3, 5, 6, 7, 8], 15))
# [4, 5]

print(find_target([1, 3, 5, 7], 14))
# 'Target not found'
