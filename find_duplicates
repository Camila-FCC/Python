def find_duplicates(arr):

    arr = sorted(arr)

    arr_set = sorted(set(arr))

    i = 0

    d = []

    while i < len(arr)-1:

        if arr[i] == arr[i+1]:
            d.append(arr[i])

        i+=1


    return sorted(list(set(d)))


print(find_duplicates([2, 34, 0, 1, -6, 23, 5, 3, 2, 5, 67, -6, 23, 2, 43, 2, 12, 0, 2, 4, 4]))

# [-6, 0, 2, 4, 5, 23]
