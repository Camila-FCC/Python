def longest_word(sentence):

    sentence = list(sentence)

    sentence = "".join(list(map(lambda x: x if x.isalpha() else " " if x == " " else "", sentence)))

    sentence = sentence.split(" ")

    words_length = sorted(list(map(lambda x: len(x), sentence)), reverse=True)

    for word in sentence:
        
        if len(word) == words_length[0]:
            return word
        

print(longest_word("Wouldn't you like to know."))
# "Wouldnt"
