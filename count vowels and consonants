def count(s):

    vowels_count = 0
    consonants_count = 0

    for item in s:
        if item.isalpha():
            vowels = "aeiouAEIOU"
            if item in vowels:
                vowels_count += 1
            else:
                consonants_count += 1
                

    return [vowels_count, consonants_count]

print(count("Hello World"))
# [3, 7]
