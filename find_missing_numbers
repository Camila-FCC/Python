def find_missing_numbers(arr):

    arr = list(set(arr))

    i = 1

    correct_arr = []

    while i < arr[len(arr)-1]:

        correct_arr.append(i)

        i+=1

    arr = sorted(arr)
    #print(arr)

    correct_arr = sorted(correct_arr)
    #print(correct_arr)

    result = []

    for item in correct_arr:

        if item not in arr:
            result.append(item)

    return result


print(find_missing_numbers([3, 1, 4, 1, 5, 9]))

# [2, 6, 7, 8]
